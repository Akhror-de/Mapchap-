<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  body { margin: 0; display: flex; align-items: center; justify-content: center; height: 100vh; background: #1a1a2e; }
  canvas { border-radius: 32px; box-shadow: 0 16px 48px rgba(0,0,0,0.5); }
</style>
</head>
<body>
<canvas id="c" width="512" height="512"></canvas>
<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');

// Фон
ctx.fillStyle = '#141432';
ctx.fillRect(0, 0, 512, 512);

// Сетка
ctx.strokeStyle = 'rgba(255,255,255,0.06)';
ctx.lineWidth = 2;
for (let i = 0; i < 512; i += 32) {
  ctx.beginPath();
  ctx.moveTo(i, 0); ctx.lineTo(i, 512);
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(0, i); ctx.lineTo(512, i);
  ctx.stroke();
}

// Пин
const pinX = 256, pinY = 210;

ctx.save();
ctx.shadowColor = 'rgba(0,0,0,0.6)';
ctx.shadowBlur = 24;
ctx.shadowOffsetY = 12;

const grad = ctx.createLinearGradient(pinX - 56, pinY - 56, pinX + 56, pinY + 56);
grad.addColorStop(0, '#007bff');
grad.addColorStop(0.7, '#8b00ff');
ctx.fillStyle = grad;

ctx.beginPath();
ctx.arc(pinX, pinY - 12, 44, 0, Math.PI * 2);
ctx.closePath();
ctx.fill();
ctx.beginPath();
ctx.moveTo(pinX - 44, pinY - 16);
ctx.quadraticCurveTo(pinX, pinY + 60, pinX + 44, pinY - 16);
ctx.closePath();
ctx.fill();

ctx.restore();

ctx.strokeStyle = 'rgba(255,255,255,0.5)';
ctx.lineWidth = 4;
ctx.beginPath();
ctx.arc(pinX, pinY - 12, 44, 0, Math.PI * 2);
ctx.stroke();
ctx.beginPath();
ctx.moveTo(pinX - 44, pinY - 16);
ctx.quadraticCurveTo(pinX, pinY + 60, pinX + 44, pinY - 16);
ctx.stroke();

ctx.fillStyle = '#ffffff';
ctx.font = 'bold 52px "Segoe UI", Arial, sans-serif';
ctx.textAlign = 'center';
ctx.textBaseline = 'middle';
ctx.fillText('M', pinX, pinY - 8);

// Блик
ctx.save();
ctx.beginPath();
ctx.arc(pinX, pinY - 12, 44, 0, Math.PI * 2);
ctx.clip();
const glassGrad = ctx.createLinearGradient(pinX - 44, pinY - 56, pinX + 44, pinY + 32);
glassGrad.addColorStop(0, 'rgba(255,255,255,0.3)');
glassGrad.addColorStop(0.5, 'rgba(255,255,255,0.05)');
glassGrad.addColorStop(1, 'rgba(255,255,255,0.15)');
ctx.fillStyle = glassGrad;
ctx.fillRect(pinX - 60, pinY - 60, 120, 120);
ctx.restore();

const img = new Image();
img.src = canvas.toDataURL('image/png');
document.body.innerHTML = '';
document.body.style.background = '#1a1a2e';
document.body.style.display = 'flex';
document.body.style.alignItems = 'center';
document.body.style.justifyContent = 'center';
img.style.width = '512px';
img.style.height = '512px';
document.body.appendChild(img);
</script>
</body>
</html>
